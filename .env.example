DB_USER=amadeus
DB_PASSWORD=your-db-password
DB_NAME=amadeus_db
DB_HOST=db
DB_PORT=5432

LLM_PROVIDER=ollama
OPENAI__API_KEY=your-openai-key
OPENAI__MODEL=gpt-5.4-mini

# Lets the api container reach Ollama on your host machine (use localhost instead if running via uvicorn, not docker-compose).
OLLAMA__HOST=http://host.docker.internal:11434
OLLAMA__MODEL=qwen3.5:4b
OLLAMA__THINK=false
